# Claude API key (or run `ant auth login` and leave this unset)
ANTHROPIC_API_KEY=

# Model that drives every LLM step and the plain-agent baseline
ALLOY_MODEL=claude-opus-5-5

# Reuse the Valency login from `codex mcp login valency` for literature discovery.
# `alloy bond-check` and `alloy bond-search "query"` make no model calls.
# The full online investigation still uses Claude for claim extraction and reasoning.
ALLOY_BOND_BACKEND=codex

# Only needed for the alternative ALLOY_BOND_BACKEND=claude hosted MCP path.
VALENCY_MCP_URL=
VALENCY_TOKEN=

# Where local outputs go (all gitignored)
ALLOY_CACHE_DIR=cache
ALLOY_RUN_DIR=runs
ALLOY_MEMORY_DIR=memory

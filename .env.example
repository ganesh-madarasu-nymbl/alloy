# Model that drives every LLM step and the plain-agent baseline. Non-Claude models use an
# OpenAI-compatible endpoint; Groq's free tier (no card) serves openai/gpt-oss-120b.
ALLOY_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=
# ALLOY_LLM_BASE_URL=https://api.groq.com/openai/v1

# Only for Claude models (ALLOY_MODEL=claude-...)
ANTHROPIC_API_KEY=

# Bond (Valency MCP). `http` calls it directly with a bearer token from Valency's OAuth
# sign-in; the refresh token renews it. `codex` reuses `codex mcp login valency` instead.
# `alloy bond-check` and `alloy bond-search "query"` make no model calls.
# The full online investigation still uses Claude for claim extraction and reasoning.
ALLOY_BOND_BACKEND=http
VALENCY_MCP_URL=https://mcp.valency.io/
VALENCY_TOKEN=
VALENCY_REFRESH_TOKEN=
VALENCY_CLIENT_ID=

# Where local outputs go (all gitignored)
ALLOY_CACHE_DIR=cache
ALLOY_RUN_DIR=runs
ALLOY_MEMORY_DIR=memory
